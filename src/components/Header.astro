---
const base = import.meta.env.BASE_URL;
const navItems = [
  { name: 'Home', href: `${base}` },
  { name: 'Technical', href: `${base}technical/` },
  { name: 'Life', href: `${base}life/` },
  { name: 'About', href: `${base}about/` }
];
---

<header class="header">
  <div class="bar">
    <a href={base} class="brand">John Q</a>

    <nav class="nav" aria-label="Main navigation">
      {navItems.map((item) => (
        <a href={item.href} class="nav-link">{item.name}</a>
      ))}
    </nav>

    <div class="right-spacer" aria-hidden="true"></div>
  </div>
</header>

<style>
  .header {
    padding: 18px 0 14px;
    border-bottom: 1px solid #e8e6e1;
  }

  .bar {
    max-width: 980px;
    margin: 0 auto;
    padding: 0 16px;
    display: grid;
    grid-template-columns: 120px 1fr 120px;
    align-items: center;
    gap: 8px;
  }

  .brand {
    font-size: 15px;
    color: #222;
    text-decoration: none;
    font-weight: 500;
    letter-spacing: 0.01em;
    white-space: nowrap;
  }

  .brand:hover { color: #111; }

  .nav {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 26px;
  }

  .nav-link {
    font-size: 14px;
    color: #6a6a6a;
    text-decoration: none;
    font-weight: 500;
    letter-spacing: 0.01em;
  }

  .nav-link:hover { color: #111; }

  .right-spacer {
    width: 120px;
    height: 1px;
  }

  @media (max-width: 760px) {
    .bar {
      grid-template-columns: 1fr;
      gap: 10px;
    }

    .nav {
      justify-content: flex-start;
      flex-wrap: wrap;
      gap: 16px;
    }

    .right-spacer { display: none; }
  }
</style>

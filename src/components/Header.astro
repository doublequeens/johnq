---
import Logo from './Logo.astro';

const base = import.meta.env.BASE_URL;
const navItems = [
  { name: 'Home', href: `${base}` },
  { name: 'Technical', href: `${base}technical/` },
  { name: 'Life', href: `${base}life/` },
  { name: 'About', href: `${base}about/` }
];
---

<header class="header">
  <div class="bar">
    <a href={base} class="brand" aria-label="John Q home">
      <Logo class="brand-logo" />
    </a>

    <nav class="nav" aria-label="Main navigation">
      {navItems.map((item) => (
        <a href={item.href} class="nav-link">{item.name}</a>
      ))}
    </nav>

    <div class="right-spacer" aria-hidden="true">
      <Logo class="brand-logo" />
    </div>
  </div>
</header>

<style>
  .header {
    padding: 18px 0 14px;
    border-bottom: none;
  }

  .bar {
    width: min(1280px, calc(100vw - 64px));
    margin-left: 50%;
    transform: translateX(-50%);
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 18px;
  }

  .brand,
  .right-spacer {
    display: inline-flex;
    align-items: center;
    white-space: nowrap;
  }

  .brand {
    text-decoration: none;
    color: #6b8e23;
  }

  :global(.brand-logo) {
    width: 220px;
    height: auto;
    display: block;
  }

  .right-spacer {
    visibility: hidden;
    pointer-events: none;
    user-select: none;
  }

  .nav {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 30px;
  }

  .nav-link {
    font-size: 20px;
    color: #4b4b4b;
    text-decoration: none;
    font-weight: 400;
    letter-spacing: -0.01em;
    line-height: 1;
  }

  .nav-link:hover { color: #111; }

  @media (max-width: 1180px) {
    .bar {
      width: min(1020px, calc(100vw - 36px));
    }

    :global(.brand-logo) {
      width: 200px;
    }

    .nav-link {
      font-size: 20px;
    }
  }

  @media (max-width: 760px) {
    .bar {
      width: calc(100vw - 24px);
      grid-template-columns: 1fr;
      gap: 12px;
    }

    :global(.brand-logo) {
      width: 150px;
    }

    .nav {
      justify-content: flex-start;
      flex-wrap: wrap;
      gap: 14px;
    }

    .nav-link {
      font-size: 24px;
    }

    .right-spacer { display: none; }
  }
</style>

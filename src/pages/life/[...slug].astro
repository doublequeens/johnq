---
import MainLayout from '../../layouts/MainLayout.astro';
import ProgressBar from '../../components/ProgressBar.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('life');
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
const fmt = post.data.date.toISOString().slice(0,10);
---

<MainLayout title={`${post.data.title} - Life`}>
  <ProgressBar />
  <article class="post-wrap">
    <header class="post-header">
      <h1 class="post-title">{post.data.title}</h1>
      <p class="post-meta">{fmt}{post.data.readTime ? ` · ${post.data.readTime}` : ''}</p>
    </header>

    <div class="post-grid">
      <aside class="toc" aria-label="Table of contents">
        <p class="toc-label">On this page</p>
        <ul>
          {headings.map((h) => (
            <li><a href={`#${h.slug}`}>{h.text}</a></li>
          ))}
        </ul>
      </aside>

      <div class="post-content">
        <Content />
      </div>
    </div>
  </article>
</MainLayout>

<style>
  .post-wrap{max-width:980px;margin:0 auto;}
  .post-header{max-width:720px;margin:10px auto 20px;}
  .post-title{font-size:42px;line-height:1.12;letter-spacing:-0.02em;margin:0 0 8px;}
  .post-meta{color:#666;font-size:14px;margin:0;}
  .post-grid{display:grid;grid-template-columns:220px minmax(0,720px);gap:28px;justify-content:center;}
  .toc{position:sticky; top:70px; align-self:start; border-left:1px solid #ececec; padding-left:14px;}
  .toc-label{font-size:12px;letter-spacing:.08em;text-transform:uppercase;color:#888;margin:0 0 8px;}
  .toc ul{list-style:none;padding:0;margin:0;}
  .toc li{margin:6px 0;}
  .toc a{color:#666;text-decoration:none;font-size:13px;}
  .toc a:hover{color:#111;}
  .post-content :global(h2){margin-top:36px;font-size:30px;}
  .post-content :global(p), .post-content :global(li){font-size:18px;line-height:1.78;color:#151515;}
  @media (max-width: 980px){
    .post-grid{grid-template-columns:1fr;}
    .toc{position:static; border-left:none; padding-left:0; margin-bottom:16px;}
  }
</style>

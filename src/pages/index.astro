---
import MainLayout from '../layouts/MainLayout.astro';
import { getCollection } from 'astro:content';

const technicalPosts = (await getCollection('technical')).sort((a,b)=> b.data.date.valueOf()-a.data.date.valueOf());
const lifePosts = (await getCollection('life')).sort((a,b)=> b.data.date.valueOf()-a.data.date.valueOf());

const base = import.meta.env.BASE_URL;
const fmt = (d: Date) => d.toISOString().slice(0,10);
---

<MainLayout title="Home - Minimalist Blog">
  <section>
    <h1 class="section-title">Technical</h1>
    <div class="cards-grid">
      {technicalPosts.map((post) => (
        <a class="card" href={`${base}technical/${post.id}/`}>
          <h2 class="card-title">{post.data.title}</h2>
          <div class="card-meta">
            <time class="card-date">{fmt(post.data.date)}</time>
            <span class="card-category">Technical</span>
            {post.data.readTime && <span class="card-read-time">{post.data.readTime}</span>}
          </div>
          <p class="card-excerpt">{post.data.excerpt}</p>
        </a>
      ))}
    </div>
  </section>

  <section>
    <h1 class="section-title">Life</h1>
    <div class="cards-grid">
      {lifePosts.map((post) => (
        <a class="card" href={`${base}life/${post.id}/`}>
          <h2 class="card-title">{post.data.title}</h2>
          <div class="card-meta">
            <time class="card-date">{fmt(post.data.date)}</time>
            <span class="card-category">Life</span>
            {post.data.readTime && <span class="card-read-time">{post.data.readTime}</span>}
          </div>
          <p class="card-excerpt">{post.data.excerpt}</p>
        </a>
      ))}
    </div>
  </section>
</MainLayout>

<style>
  .section-title { font-size: 30px; font-weight: 650; margin: 28px 0 16px; }
  .cards-grid { display:grid; grid-template-columns: repeat(auto-fill,minmax(300px,1fr)); gap:20px; margin-bottom:42px; }
  a.card { text-decoration:none; color:inherit; }
</style>

---
import MainLayout from '../../layouts/MainLayout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('technical');
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
const fmt = post.data.date.toISOString().slice(0, 10);
---

<MainLayout title={`${post.data.title} - Technical`}>
  <div class="reading-chrome" id="reading-chrome" aria-hidden="true">
    <div class="chrome-bar">
      <div class="chrome-title">{post.data.title}</div>
      {headings.length > 0 && (
        <button
          class="toc-toggle"
          id="toc-toggle"
          type="button"
          aria-label="Table of contents"
          title="Table of contents"
          aria-expanded="false"
          aria-controls="toc-panel"
        >
          <svg class="toc-icon" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M4 6.5h16M4 12h16M4 17.5h16" />
          </svg>
        </button>
      )}
    </div>

    <div class="progress-container" aria-hidden="true">
      <div class="progress-bar" id="reading-progress"></div>
    </div>

    {headings.length > 0 && (
      <aside class="toc-panel" id="toc-panel" aria-label="Table of contents" hidden>
        <ul>
          {headings.map((h) => (
            <li><a href={`#${h.slug}`} data-toc-link={h.slug}>{h.text}</a></li>
          ))}
        </ul>
      </aside>
    )}
  </div>

  <article class="post-wrap" id="post-wrap">
    <header class="post-header" id="post-header">
      <h1 class="post-title">{post.data.title}</h1>
      <p class="post-meta">{fmt}{post.data.readTime ? ` · ${post.data.readTime}` : ''}</p>
    </header>

    <div class="post-content">
      <Content />
    </div>
  </article>

  <script>
    const chrome = document.getElementById('reading-chrome');
    const bar = document.getElementById('reading-progress');
    const postHeader = document.getElementById('post-header');

    const toggle = document.getElementById('toc-toggle');
    const panel = document.getElementById('toc-panel');
    const tocLinks = panel ? Array.from(panel.querySelectorAll('[data-toc-link]')) : [];

    const setTocOpen = (open) => {
      if (!toggle || !panel) return;
      toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
      panel.hidden = !open;
    };

    if (toggle && panel) {
      toggle.addEventListener('click', (e) => {
        e.stopPropagation();
        setTocOpen(panel.hidden);
      });

      document.addEventListener('click', (e) => {
        const target = e.target;
        if (!(target instanceof Node)) return;
        if (!panel.hidden && !panel.contains(target) && !toggle.contains(target)) {
          setTocOpen(false);
        }
      });

      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') setTocOpen(false);
      });

      tocLinks.forEach((link) => link.addEventListener('click', () => setTocOpen(false)));
    }

    const sections = tocLinks
      .map((link) => {
        const slug = link.getAttribute('data-toc-link');
        const el = slug ? document.getElementById(slug) : null;
        return el ? { el, link } : null;
      })
      .filter(Boolean);

    if (sections.length) {
      const observer = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              const id = entry.target.getAttribute('id');
              tocLinks.forEach((l) => l.classList.remove('active'));
              const current = tocLinks.find((l) => l.getAttribute('data-toc-link') === id);
              current?.classList.add('active');
            }
          }
        },
        { rootMargin: '-16% 0px -72% 0px', threshold: 0 }
      );

      sections.forEach((s) => observer.observe(s.el));
    }

    const updateReadingChrome = () => {
      if (!chrome) return;
      const y = window.scrollY || document.documentElement.scrollTop;
      const headerBottom = postHeader
        ? postHeader.getBoundingClientRect().bottom + (window.scrollY || document.documentElement.scrollTop)
        : 140;
      const show = y > headerBottom - 56;

      chrome.classList.toggle('visible', show);
      chrome.setAttribute('aria-hidden', show ? 'false' : 'true');

      if (!show) setTocOpen(false);

      if (bar) {
        const total = document.documentElement.scrollHeight - window.innerHeight;
        const p = total > 0 ? Math.min(100, Math.max(0, (y / total) * 100)) : 0;
        bar.style.width = `${p}%`;
      }
    };

    updateReadingChrome();
    window.addEventListener('scroll', updateReadingChrome, { passive: true });
    window.addEventListener('resize', updateReadingChrome);
  </script>
</MainLayout>

<style>
  .reading-chrome {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 1010;
    opacity: 0;
    transform: translateY(-8px);
    pointer-events: none;
    transition: opacity 0.18s ease, transform 0.18s ease;
  }

  .reading-chrome.visible {
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
  }

  .chrome-bar {
    height: 42px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 14px;
    background: rgba(244, 242, 236, 0.94);
    border-bottom: 1px solid rgba(23, 23, 23, 0.1);
    backdrop-filter: blur(6px);
  }

  .chrome-title {
    font-size: 18px;
    line-height: 1.3;
    color: #161616;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    padding-right: 12px;
  }

  .toc-toggle {
    flex: 0 0 auto;
    width: 24px;
    height: 24px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 0;
    background: transparent;
    color: #6a6a6a;
    cursor: pointer;
    padding: 0;
  }
  .toc-toggle:hover { color: #161616; }

  .toc-icon {
    width: 18px;
    height: 18px;
    stroke: currentColor;
    stroke-width: 1.8;
    fill: none;
    stroke-linecap: round;
  }

  .progress-container {
    height: 2px;
    background: rgba(17, 17, 17, 0.08);
  }

  .progress-bar {
    width: 0%;
    height: 100%;
    background: linear-gradient(90deg, #2a2aff 0%, #6c6cff 55%, rgba(108, 108, 255, 0) 100%);
    box-shadow: 0 0 8px rgba(61, 61, 255, 0.62), 0 0 16px rgba(61, 61, 255, 0.3);
    transition: width 80ms linear;
  }

  .toc-panel {
    position: absolute;
    right: 10px;
    top: 46px;
    width: 220px;
    max-height: min(62vh, 460px);
    overflow: auto;
    border: 1px solid #e1ddd3;
    background: rgba(246, 244, 239, 0.98);
    border-radius: 10px;
    box-shadow: 0 12px 28px rgba(0, 0, 0, 0.08);
    padding: 10px 10px 10px 8px;
  }

  .toc-panel ul { list-style: none; margin: 0; padding: 0; }
  .toc-panel li { margin: 5px 0; }

  .toc-panel a {
    display: block;
    font-size: 12px;
    line-height: 1.35;
    color: #727272;
    text-decoration: none;
    border-left: 2px solid transparent;
    padding: 2px 0 2px 8px;
  }
  .toc-panel a:hover { color: #1f1f1f; border-left-color: #c7c7c7; }
  .toc-panel a.active { color: #141414; border-left-color: #141414; font-weight: 500; }

  .post-wrap { max-width: 820px; margin: 0 auto; }
  .post-header { margin: 10px 0 20px; }
  .post-title { font-size: 42px; line-height: 1.12; letter-spacing: -0.02em; margin: 0 0 8px; }
  .post-meta { color: #666; font-size: 14px; margin: 0; }

  .post-content :global(h2) { margin-top: 36px; font-size: 30px; }
  .post-content :global(p), .post-content :global(li) { font-size: 18px; line-height: 1.78; color: #151515; }

  @media (max-width: 980px) {
    .chrome-bar { height: 40px; padding: 0 10px; }
    .chrome-title { font-size: 16px; }
    .toc-panel { width: min(72vw, 260px); right: 8px; top: 44px; }
  }
</style>

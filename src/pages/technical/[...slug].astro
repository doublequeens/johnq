---
import MainLayout from '../../layouts/MainLayout.astro';
import ProgressBar from '../../components/ProgressBar.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('technical');
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
const fmt = post.data.date.toISOString().slice(0,10);
---

<MainLayout title={`${post.data.title} - Technical`}>
  <div class="reading-title" id="reading-title">{post.data.title}</div>
  <ProgressBar />

  <article class="post-wrap">
    <header class="post-header">
      <h1 class="post-title">{post.data.title}</h1>
      <p class="post-meta">{fmt}{post.data.readTime ? ` · ${post.data.readTime}` : ''}</p>
    </header>

    <div class="post-grid">
      <div class="post-content">
        <Content />
      </div>

      <aside class="toc" aria-label="Table of contents">
        <p class="toc-label">Table of contents</p>
        <ul>
          {headings.map((h) => (
            <li><a href={`#${h.slug}`} data-toc-link={h.slug}>{h.text}</a></li>
          ))}
        </ul>
      </aside>
    </div>
  </article>

  <script>
    const links = Array.from(document.querySelectorAll('[data-toc-link]'));
    const sections = links
      .map((link) => {
        const slug = link.getAttribute('data-toc-link');
        const el = slug ? document.getElementById(slug) : null;
        return el ? { slug, el, link } : null;
      })
      .filter(Boolean);

    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            const id = entry.target.getAttribute('id');
            links.forEach((l) => l.classList.remove('active'));
            const current = links.find((l) => l.getAttribute('data-toc-link') === id);
            current?.classList.add('active');
          }
        }
      },
      { rootMargin: '-20% 0px -70% 0px', threshold: 0 }
    );

    sections.forEach((s) => observer.observe(s.el));
  </script>
</MainLayout>

<style>
  .reading-title {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    height: 44px;
    z-index: 1002;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0 16px;
    font-size: 13px;
    font-weight: 600;
    color: #2a2a2a;
    background: rgba(246, 245, 242, 0.9);
    backdrop-filter: blur(6px);
    border-bottom: 1px solid rgba(0, 0, 0, 0.06);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .post-wrap { max-width: 1140px; margin: 0 auto; padding-top: 64px; }
  .post-header { max-width: 760px; margin: 10px auto 20px; }
  .post-title { font-size: 42px; line-height: 1.12; letter-spacing: -0.02em; margin: 0 0 8px; }
  .post-meta { color: #666; font-size: 14px; margin: 0; }

  .post-grid {
    display: grid;
    grid-template-columns: minmax(0, 760px) 260px;
    gap: 44px;
    justify-content: center;
    align-items: start;
  }

  .toc {
    position: sticky;
    top: 72px;
    align-self: start;
  }

  .toc-label {
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #8a8a8a;
    margin: 0 0 10px;
  }

  .toc ul { list-style: none; padding: 0; margin: 0; }
  .toc li { margin: 8px 0; }

  .toc a {
    display: block;
    padding-left: 12px;
    border-left: 2px solid transparent;
    color: #6d6d6d;
    text-decoration: none;
    font-size: 13px;
    line-height: 1.4;
    transition: all 0.18s ease;
  }

  .toc a:hover { color: #111; border-left-color: #d8d8d8; }
  .toc a.active { color: #111; border-left-color: #111; font-weight: 500; }

  .post-content :global(h2) { margin-top: 36px; font-size: 30px; }
  .post-content :global(p), .post-content :global(li) { font-size: 18px; line-height: 1.78; color: #151515; }

  @media (max-width: 980px) {
    .reading-title { height: 40px; }
    .post-wrap { padding-top: 58px; }
    .post-grid { grid-template-columns: 1fr; }
    .toc { position: static; margin-top: 18px; }
  }
</style>

---
import MainLayout from '../../layouts/MainLayout.astro';
import ProgressBar from '../../components/ProgressBar.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('technical');
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
const fmt = post.data.date.toISOString().slice(0,10);
---

<MainLayout title={`${post.data.title} - Technical`}>
  <div class="reading-title" id="reading-title">{post.data.title}</div>
  <ProgressBar />

  {headings.length > 0 && (
    <div class="toc-float" id="toc-float">
      <button class="toc-toggle" id="toc-toggle" type="button" aria-expanded="false" aria-controls="toc-panel">
        Contents
      </button>
      <aside class="toc-panel" id="toc-panel" aria-label="Table of contents" hidden>
        <ul>
          {headings.map((h) => (
            <li><a href={`#${h.slug}`} data-toc-link={h.slug}>{h.text}</a></li>
          ))}
        </ul>
      </aside>
    </div>
  )}

  <article class="post-wrap">
    <header class="post-header">
      <h1 class="post-title">{post.data.title}</h1>
      <p class="post-meta">{fmt}{post.data.readTime ? ` · ${post.data.readTime}` : ''}</p>
    </header>

    <div class="post-content">
      <Content />
    </div>
  </article>

  <script>
    const tocWrap = document.getElementById('toc-float');
    const toggle = document.getElementById('toc-toggle');
    const panel = document.getElementById('toc-panel');

    if (tocWrap && toggle && panel) {
      const links = Array.from(panel.querySelectorAll('[data-toc-link]'));

      const setOpen = (open) => {
        toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
        panel.hidden = !open;
        tocWrap.classList.toggle('open', open);
      };

      toggle.addEventListener('click', (e) => {
        e.stopPropagation();
        setOpen(panel.hidden);
      });

      document.addEventListener('click', (e) => {
        if (!tocWrap.contains(e.target)) setOpen(false);
      });

      links.forEach((link) => {
        link.addEventListener('click', () => setOpen(false));
      });

      const sections = links
        .map((link) => {
          const slug = link.getAttribute('data-toc-link');
          const el = slug ? document.getElementById(slug) : null;
          return el ? { el, link } : null;
        })
        .filter(Boolean);

      const observer = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              const id = entry.target.getAttribute('id');
              links.forEach((l) => l.classList.remove('active'));
              const current = links.find((l) => l.getAttribute('data-toc-link') === id);
              current?.classList.add('active');
            }
          }
        },
        { rootMargin: '-20% 0px -70% 0px', threshold: 0 }
      );

      sections.forEach((s) => observer.observe(s.el));
    }
  </script>
</MainLayout>

<style>
  .reading-title {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    height: 44px;
    z-index: 1002;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0 16px;
    font-size: 13px;
    font-weight: 600;
    color: #2a2a2a;
    background: rgba(246, 245, 242, 0.9);
    backdrop-filter: blur(6px);
    border-bottom: 1px solid rgba(0, 0, 0, 0.06);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .toc-float {
    position: fixed;
    right: 22px;
    top: 54px;
    z-index: 1003;
  }

  .toc-toggle {
    height: 28px;
    border: 1px solid #dedcd7;
    background: rgba(250, 249, 246, 0.92);
    color: #666;
    font-size: 12px;
    line-height: 1;
    padding: 0 10px;
    border-radius: 999px;
    cursor: pointer;
  }

  .toc-toggle:hover { color: #1f1f1f; border-color: #cfcac1; }

  .toc-panel {
    margin-top: 8px;
    width: 220px;
    max-height: min(60vh, 460px);
    overflow: auto;
    border: 1px solid #e2ded6;
    background: rgba(248, 247, 243, 0.98);
    border-radius: 10px;
    box-shadow: 0 10px 32px rgba(0, 0, 0, 0.08);
    padding: 10px 10px 10px 8px;
  }

  .toc-panel ul { list-style: none; margin: 0; padding: 0; }
  .toc-panel li { margin: 5px 0; }

  .toc-panel a {
    display: block;
    font-size: 12px;
    line-height: 1.35;
    color: #727272;
    text-decoration: none;
    border-left: 2px solid transparent;
    padding: 2px 0 2px 8px;
  }

  .toc-panel a:hover { color: #1f1f1f; border-left-color: #c7c7c7; }
  .toc-panel a.active { color: #141414; border-left-color: #141414; font-weight: 500; }

  .post-wrap { max-width: 820px; margin: 0 auto; padding-top: 64px; }
  .post-header { margin: 10px 0 20px; }
  .post-title { font-size: 42px; line-height: 1.12; letter-spacing: -0.02em; margin: 0 0 8px; }
  .post-meta { color: #666; font-size: 14px; margin: 0; }

  .post-content :global(h2) { margin-top: 36px; font-size: 30px; }
  .post-content :global(p), .post-content :global(li) { font-size: 18px; line-height: 1.78; color: #151515; }

  @media (max-width: 980px) {
    .reading-title { height: 40px; }
    .toc-float { right: 12px; top: 48px; }
    .toc-panel { width: min(70vw, 260px); }
    .post-wrap { padding-top: 58px; }
  }
</style>
